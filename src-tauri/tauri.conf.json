{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daily Sticky Note",
  "version": "1.4.5",
  "identifier": "com.amarcu.dailystickynote",
  "build": {
    "frontendDist": "../docs"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/amarcu/daily-sticky-note/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGMzNFMTAwOEFCOTU0NTYKUldSV1ZMbUtBT0V6WDNWcExmYjlJOFlhSEsrQkZMS2NNdjdFVTZZSmQwNlFtMGgxWW9FdzFsRkoK"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Daily sticky note",
        "width": 320,
        "height": 560,
        "minWidth": 320,
        "maxWidth": 320,
        "minHeight": 220,
        "x": 40,
        "y": 40,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "Always-on-top sticky note task list",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
